# Kopier denne filen til .env.local og fyll inn verdiene fra Supabase.
# (.env.local committes ikke – den er i .gitignore.)

# Fra Supabase: Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://DITT-PROSJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din-anon-public-key

# Service-role-nøkkel (KUN server). Brukes til poengberegning og admin-fasit.
# Hold hemmelig – legg den aldri i NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=din-service-role-key

# Domenet som får logge inn (Google-konti). Default: fiken.no
TILLATT_DOMENE=fiken.no

# Kommaseparert liste over admin-e-poster (kan legge inn fasit).
ADMIN_EPOSTER=ashild.knudsen@fiken.no

# Tippefrist (ISO 8601). Etter dette låses tippingen. Default: VM-start.
TIPPEFRIST=2026-06-11T19:00:00Z

# Felles sluttfrist for sluttspillet (fase 2). Hele treet låses senest da;
# enkeltkamper som starter før låses likevel ved sitt eget avspark.
# Default: tirsdag 30. juni 2026 kl. 16 norsk tid (= 14:00 UTC).
SLUTTSPILLFRIST=2026-06-30T14:00:00Z

# Automatisk henting av resultater fra football-data.org.
# Gratis token (uten kort): https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=din-football-data-token

# Hemmelig streng som beskytter cron-endepunktet. Vercel sender den automatisk
# som Bearer-token til /api/oppdater-fasit. Lag en tilfeldig streng.
CRON_SECRET=en-tilfeldig-hemmelig-streng
